<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title><%= title %></title>
  <link rel='stylesheet' href='/stylesheets/style.css' />
</head>
<body class="edit">

  <nav>
    <ul>
      <li><a href="/games">Lista gier</a></li>
      <li><a href="/games/create">Dodaj grę</a></li>
    </ul>
  </nav>

  <main>
    <h1><%= title %></h1>

    <form action="/games/<%= game.id %>/edit" method="post" class="edit-form">
      <div class="form-group">
        <label for="title">Title</label>
        <input type="text" id="title" name="title" value="<%= game.title %>" required>
      </div>
      <div class="form-group">
        <label for="description">Description</label>
        <textarea id="description" name="description" required><%= game.description %></textarea>
      </div>
      <div class="form-group">
        <input type="submit" value="Submit">
      </div>
    </form>

    <ul class="action-list">
      <li><a href="/games">Back to list</a></li>
      <li>
        <form action="/games/<%= game.id %>/delete" method="post" style="display:inline;">
          <input type="submit" value="Delete" onclick="return confirm('Are you sure?')">
        </form>
      </li>
    </ul>
  </main>

  <footer>
    <p>&copy; 2026 Lab Express.js</p>
  </footer>

</body>
</html>